# The Planday app's App Id (Settings > Integrations > API Access). Not a secret.
PLANDAY_CLIENT_ID=
# The app's Token (a refresh token). A secret.
PLANDAY_REFRESH_TOKEN=
# Planday's addresses; others need PLANDAY_ALLOW_CUSTOM_BASE_URL=true (loopback http is allowed for local mocks).
# PLANDAY_BASE_URL=https://openapi.planday.com
# PLANDAY_TOKEN_URL=https://id.planday.com/connect/token
# PLANDAY_ALLOW_CUSTOM_BASE_URL=false
PLANDAY_TIMEOUT_MS=30000
PLANDAY_MAX_CONCURRENCY=4
# Largest response body read from the upstream API (bytes, max 104857600).
PLANDAY_MAX_RESPONSE_BYTES=10485760

# Write tools are disabled unless this is true.
PLANDAY_ENABLE_WRITES=false
# Comma-separated tool names to disable (with or without the planday_ prefix).
PLANDAY_DISABLED_TOOLS=
# JSONL audit trail; write tools refuse to run if it cannot be written.
PLANDAY_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
